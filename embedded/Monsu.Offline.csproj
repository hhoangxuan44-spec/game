<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the embedded server against the game's own (Unity 4.6 / Mono 2.0) class libraries.
       build/build.sh passes -p:ManagedDir=<folder with the game's mscorlib.dll, UnityEngine.dll ...> -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MonsuOffline</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>UNITY</DefineConstants>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Json.cs;Data.cs;Content.cs;Game.cs;Entry.cs" />
    <Reference Include="mscorlib"><HintPath>$(ManagedDir)/mscorlib.dll</HintPath></Reference>
    <Reference Include="System"><HintPath>$(ManagedDir)/System.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath></Reference>
  </ItemGroup>
</Project>
