<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the embedded server on normal .NET: replays a scenario and prints one JSON response per line. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Replay.cs;../Json.cs;../Data.cs;../Content.cs;../Game.cs" />
  </ItemGroup>
</Project>
